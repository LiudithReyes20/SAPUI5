<mvc:View controllerName="alfagroup.sapui5.controller.HelloPanel"
          xmlns="sap.m" 
          xmlns:mvc="sap.ui.core.mvc"
          xmlns:core="sap.ui.core"
          displayBlock="true">
    <Panel id="_IDGenPanel" headerText="{i18n>HelloPanel}" class="sapUiResponsiveMargin" width="auto">
        <content>
    <!--<Text id="_IDGenText" text="Hello World0000"></Text>-->
                <Button icon="sap-icon://action" 
                        id="_IDGenButton1" 
                        text="{i18n>helloDialogBut}" 
                        press=" .onOpenDialog" 
                        class="sapUiSmallMarginEnd"/>

            <Button id="_IDGenButton" 
                    text="{i18n>showHelloButtonText}" 
                    press=" .onShowHello" 
                    class="sapUiSmallMarginEnd"/>

            <Input id="_IDGenInput" 
                   value ="{/recipient/name}"
                   valueLiveUpdate="true"
                   width="60%"/>
            <Text id="_IDGenText0" text="Hello {/recipient/name}" class="sapUiSmallMargin boldElements sapthemeHighlight-asColor"/>
        </content>
    </Panel>
</mvc:View>