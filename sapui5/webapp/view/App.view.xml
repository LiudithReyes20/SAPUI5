<mvc:View controllerName="alfagroup.sapui5.controller.App"
          xmlns="sap.m" 
          xmlns:mvc="sap.ui.core.mvc"
        xmlns:core="sap.ui.core"

          displayBlock="true">
    <Shell id="_IDGenShell">
        <App id="_IDGenApp" >
            <pages>
                <Page id="_IDGenPage" title="{i18n>appTitle}">

                <headerContent>
                <Button id="HelloDialogHeader" 
                        icon="sap-icon://action"
                        press=".onOpenDialogHeader"
                        class="sapUiSmallMarginEnd"/>
                
                </headerContent>
                    <content>


                         <mvc:XMLView id="_IDGenXMLView2" viewName="alfagroup.sapui5.view.HelloPanel"/>
                        <core:Fragment fragmentName="alfagroup.sapui5.view.Form01" type="XML"/>
                         <mvc:XMLView id="_IDGenXMLView1"  viewName="alfagroup.sapui5.view.InvoicesList"/>

        

                     </content>

                </Page>
            </pages>
        </App>
    </Shell>
</mvc:View>
